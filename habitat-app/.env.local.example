# Copy this file to .env.local on the deploy server and fill in real values.
# .env.local is read by docker-compose.yml via env_file — it is never
# committed to git and never baked into the Docker image.

# Overridden by docker-compose.yml's `environment:` block to point at the
# mongodb service, but src/lib/mongodb.js still requires it to be set.
MONGODB_URI=mongodb://mongodb:27017/habitat_db?directConnection=true&serverSelectionTimeoutMS=2000

# NextAuth
NEXTAUTH_URL=https://your-production-domain.example.com
NEXTAUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
